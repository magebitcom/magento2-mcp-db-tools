<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::system">
                    <resource id="Magebit_Mcp::mcp">
                        <resource id="Magebit_McpDbTools::config"
                                  title="MCP Database Reader Configuration" sortOrder="60"/>
                        <resource id="Magebit_Mcp::tools">
                            <resource id="Magebit_McpDbTools::tool_db_query"
                                      title="Tool: Run Read-Only SQL Query" sortOrder="400"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
