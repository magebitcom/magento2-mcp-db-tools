<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        Tool registration for this module. The item key must equal the tool's getName(), which
        Magebit\Mcp\Model\Tool\ToolRegistry enforces at construction.
    -->
    <type name="Magebit\Mcp\Model\Tool\ToolRegistry">
        <arguments>
            <argument name="tools" xsi:type="array">
                <item name="db.query" xsi:type="object">Magebit\McpDbTools\Tool\Db\Query</item>
            </argument>
        </arguments>
    </type>

    <!--
        This module's own settings gate this module: system.config.set must never be able to flip
        `enabled` or widen `allowed_tables`. The core's protected-prefix list is generic, so the
        prefix is contributed from here — the section name lives in this module, not in the core.
    -->
    <type name="Magebit\Mcp\Model\Config\ConfigWritePolicy">
        <arguments>
            <argument name="protectedPrefixes" xsi:type="array">
                <item name="magebit_mcp_db_tools" xsi:type="string">magebit_mcp_db_tools</item>
            </argument>
        </arguments>
    </type>
    <!-- Mirrored on the read side so the settings are not readable back out through system.config.get. -->
    <type name="Magebit\Mcp\Model\Config\SensitiveFieldGuard">
        <arguments>
            <argument name="blockedPrefixes" xsi:type="array">
                <item name="magebit_mcp_db_tools" xsi:type="string">magebit_mcp_db_tools</item>
            </argument>
        </arguments>
    </type>

    <!--
        The shipped protected set is a class constant on TableAccessPolicy, not a di.xml argument:
        Magento merges array arguments by item name, so any module re-declaring an item name would
        replace that entry and quietly drop a table from the protected set. Its three additive
        constructor arguments remain the extension point — a module may add its own
        credential-bearing tables there, and can never remove one the floor declares.
    -->
</config>
